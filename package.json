{
  "name": "ai-agent-control-center",
  "version": "0.1.0",
  "private": true,
  "main": "app/background.js",
  "scripts": {
    "dev": "nextron",
    "build": "nextron build",
    "postinstall": "node scripts/patch-winpty.js && electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@xstate/react": "^6.1.0",
    "better-sqlite3": "^11.0.0",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-serve": "^1.3.0",
    "electron-store": "^8.2.0",
    "lucide-react": "^1.21.0",
    "next": "^14.2.0",
    "nextron": "^9.0.0",
    "node-pty": "^1.1.0",
    "p-queue": "^6.6.2",
    "pixi.js": "^8.19.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "xstate": "^5.32.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.0",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.agentflow.control-center",
    "productName": "AgentFlow Control Center",
    "files": [
      "app/**/*",
      "renderer/.next/**/*",
      "renderer/public/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
